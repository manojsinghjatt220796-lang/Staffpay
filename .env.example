# Server Runtime Configuration
NODE_ENV="production"
PORT="3000"
APP_URL="https://app.yourdomain.com"

# Persistent Storage Paths (Keep outside dist/ so deployments never overwrite data)
DATA_DIR="./storage"
DATABASE_PATH="./storage/staffpay.db"
UPLOAD_DIR="./storage/uploads"
BACKUP_DIR="./storage/backups"

# CORS Allowlist (Comma-separated origins for web domains; mobile apps use Bearer tokens)
CORS_ORIGINS="https://app.yourdomain.com,https://admin.yourdomain.com"

# Session Token Lifetimes
ACCESS_TOKEN_TTL_MINUTES="60"
REFRESH_TOKEN_TTL_DAYS="30"

# Initial Super Admin Credentials (Optional: if left empty, claim once via /super-admin UI)
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Payment Gateway (Razorpay — Required before Paid Subscriptions / Live Revenue are verified)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VITE_RAZORPAY_KEY_ID=""
